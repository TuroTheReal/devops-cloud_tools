# Copy to .env, fill in, then: set -a; source .env; set +a
# Never commit your real .env (it carries a live API token).

# Cloudflare API token. Scopes needed (verify exact names in the CF dashboard):
#   - Zone   > DNS              > Edit   (custom-domain scripts)
#   - Zone   > Workers Routes   > Edit   (route scripts)
#   - Account > Workers Scripts > Edit   (custom-domain scripts)
#   - Account > Cloudflare Pages > Edit  (custom-domain scripts)
CLOUDFLARE_API_TOKEN=

# Cloudflare account id (custom-domain scripts only).
ACCOUNT_ID=

# Zone id of the host's domain (all scripts).
ZONE_ID=
